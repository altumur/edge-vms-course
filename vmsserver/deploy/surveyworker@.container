# /etc/containers/systemd/surveyworker@.container — a survey worker: the sixth
# subsystem's worker. `systemctl start surveyworker@s-1` — the instance name is
# the slot. It watches a camera's DEVICE archive — a card, an NVR — for ever, and
# copies none of it: the video stays where it is and what comes out is events.
#
# Its budget is SURVEY_CAPACITY and not CAPACITY: a survey must never be able to
# spend the streams live detection is running on. Its real limit is usually not
# the GPU but the two playback sessions the device allows, which it shares with
# the operator watching and the recorder saving — so it waits and says so rather
# than retrying into a wall. It mounts the archive because its EVENTS go there;
# no spool, because it records nothing.
[Unit]
Description=VMS survey worker %i — models over an archive we do not own
After=network.target

[Container]
Image=localhost/vmsserver:latest
Exec=python3 -m vms surveyworker
Environment=SURVEY_NAME=%i
EnvironmentFile=/data/config/vms.env
Volume=/data/platform:/data/platform:z
Volume=/data/archive:/data/archive:z
AddDevice=/dev/dri
Network=host
StopTimeout=10

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
