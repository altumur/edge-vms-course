# deploy/Containerfile — localhost/clustervms:latest
# Build from the COURSE ROOT: М10's vmsserver plus this package. One image,
# four entrypoints: python3 -m cluster worker | controller | console | resource.
#   podman build -f М11_ClusterVMS/clustervms/deploy/Containerfile -t localhost/clustervms:latest .
FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-gi \
        gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
        gir1.2-gst-plugins-base-1.0 curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY М10_ServerVMS/vmsserver vmsserver
COPY М11_ClusterVMS/clustervms/cluster cluster
ENV VMSSERVER_PATH=/app/vmsserver PYTHONPATH=/app/vmsserver
CMD ["python3", "-m", "cluster", "worker"]
