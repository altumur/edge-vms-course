#!/bin/sh
# Lesson 18, Step 3 — decides whether the running slot is kept. Exit 0 = good.
#
# This is the highest-stakes alert rule in the course: it decides whether an
# OS update is kept or rolled back. It runs ON THE BOX and touches NOTHING
# outside it — a check that asks a remote system whether it is healthy turns
# a network fault into a fleet-wide rollback that looks like diligence.
#
# The ladder, bottom row is the one that matters:
#   1. no failed units                   (catches crashed services)
#   2. the VMS answers                   (catches startup failures)
#   3. FOOTAGE IS ACTUALLY BEING WRITTEN (catches the update that boots perfectly and records nothing)
#
# Row 3 has two sources. With М10's recorder installed, it is the recorder's own
# exported signal, recorder_camera_silent_seconds_max — the same number М13
# alarms on, read locally. Without it (an М9-only bench) it is the Lesson 18
# stand-in: a segment appeared in the spool recently.
set -e

NODE_METRICS="${NODE_METRICS:-http://127.0.0.1:8080/metrics}"
AGENT_HEALTH="${AGENT_HEALTH:-http://127.0.0.1:8000/health}"
SPOOL="${SPOOL:-/data/spool}"
# Longer than one segment, or a healthy recorder fails the check between segment
# closes. Lesson 22 makes SEGMENT_SECONDS a product decision; this follows it.
SEGMENT_SECONDS="${SEGMENT_SECONDS:-600}"
WINDOW="${HEALTH_WINDOW:-$((SEGMENT_SECONDS * 2 + 60))}"

fail() { echo "health: $*" >&2; exit 1; }

# 1. No failed systemd units.
if systemctl --failed --no-legend 2>/dev/null | grep -q .; then
    systemctl --failed --no-legend >&2
    fail "failed units present"
fi

# 2 + 3. Prefer the recorder.
if METRICS="$(curl -fsS --max-time 5 "$NODE_METRICS" 2>/dev/null)"; then
    val() { printf '%s\n' "$METRICS" | awk -v k="$1" '$1==k {print $2; found=1} END {if (!found) print "MISSING"}'; }
    reporting="$(val recorder_node_reporting)"
    cameras="$(val recorder_cameras)"
    silent="$(val recorder_camera_silent_seconds_max)"
    never="$(val recorder_cameras_never_recorded)"
    for v in "$reporting" "$cameras" "$silent" "$never"; do
        [ "$v" = "MISSING" ] && fail "recorder metrics answered but are missing a required series"
    done
    [ "$reporting" = "1" ] || fail "recorder console answers but the AppHost is not reporting"
    if [ "$cameras" -eq 0 ]; then
        # A product decision, stated rather than hidden: a box with no cameras
        # configured cannot prove footage, so the OS update is judged on rows
        # 1–2 only. Commissioning should add a camera before the first update.
        echo "health: OK (no cameras configured — footage test vacuous)"
        exit 0
    fi
    [ "$never" -lt "$cameras" ] || fail "no camera has written a segment ($cameras configured)"
    [ "${silent%.*}" -le "$WINDOW" ] || fail "newest segment is ${silent}s old (window ${WINDOW}s)"
    echo "health: OK (recorder: $cameras cameras, newest segment ${silent}s ago)"
    exit 0
fi

# М9-only: the М8 agent and the spool.
curl -fsS --max-time 5 "$AGENT_HEALTH" >/dev/null 2>&1 || fail "no recorder at $NODE_METRICS and the agent did not answer at $AGENT_HEALTH"
# Stand-in, as Lesson 18 marks it: a segment appeared in the spool recently.
# Weak on purpose — a fast uploader empties the spool — and replaced above.
find "$SPOOL" -name '*.mp4' -newermt "-${WINDOW} seconds" 2>/dev/null | grep -q . \
    || fail "no segment written to $SPOOL in the last ${WINDOW}s (stand-in check)"
echo "health: OK (agent + spool stand-in)"
