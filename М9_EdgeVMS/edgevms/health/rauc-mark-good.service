# Lesson 3, Step 3. A plain unit (not Quadlet), so `systemctl enable` is right.
# ExecStartPost runs only if ExecStart succeeded: if the health check fails,
# nothing is marked, <slot>_TRY stays set, and the next boot goes back.
# The rollback needs no code.
[Unit]
Description=Confirm this slot works, or leave it unconfirmed
After=network-online.target worker.service vms-agent.service vmsworker@w-1.service vmsconsole.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Give the system time to actually start doing its job before judging it.
# Must exceed one segment length (М9 Lesson 7) plus startup; the bench shortens it.
ExecStartPre=/bin/sleep 150
ExecStart=/usr/local/bin/rauc-health-check
ExecStartPost=/usr/bin/rauc status mark-good

[Install]
WantedBy=multi-user.target
